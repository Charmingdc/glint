{
  "name": "glint",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev:website": "pnpm --filter web dev",
    "dev:docs": "pnpm --filter docs dev",
    "build:core": "pnpm --filter @glintjs/core build && pnpm --filter '!@glintjs/core' -r build",
    "build:react": "pnpm --filter @glintjs/react build && pnpm --filter '!@glintjs/react' -r build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}
