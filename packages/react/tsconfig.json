{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "lib": ["ES2022", "DOM"],

    "types": ["node", "react"],

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tsup.config.ts"]
}
